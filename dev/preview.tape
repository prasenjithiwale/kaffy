Output preview.gif
Output preview.mp4
Set Shell bash
Set FontSize 14
Set Width 1200
Set Height 680
Set Padding 12
Set Framerate 12
Set TypingSpeed 70ms
Set Theme "Catppuccin Mocha"
Env COLORTERM truecolor
Env PS1 "$ "

Hide
Type "./kaffy --demo"
Enter
Sleep 2s
Type "2"
Sleep 22s
Type "1"
Sleep 1s
Show
Sleep 2s
Screenshot s1-topics.png
Sleep 1s
Type ":"
Sleep 600ms
Type "orders"
Sleep 800ms
Enter
Sleep 3.5s
Screenshot s2-messages.png
Sleep 1s
Type "/"
Sleep 500ms
Type '~"status":"(PAID|SHIPPED)" p:0,1'
Sleep 800ms
Enter
Sleep 2.5s
Screenshot s3-filtered.png
Sleep 1s
Enter
Sleep 3s
Screenshot s4-detail.png
Sleep 1s
Type "2"
Sleep 3s
Screenshot s5-groups.png
Sleep 1s
Enter
Sleep 3.5s
Screenshot s6-group.png
Sleep 1s
Type "R"
Sleep 2s
Type "a"
Sleep 1.5s
Type "l"
Sleep 4s
Screenshot s7-reset.png
Sleep 1s
Escape
Sleep 1.5s
Screenshot s8-after-esc.png
Sleep 1s
Type "3"
Sleep 2s
Screenshot s9-schemas.png
Sleep 1s
Enter
Sleep 1.5s
Type "d"
Sleep 3s
Screenshot s10-diff.png
Sleep 1s
Hide
Type "q"
